# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# Comma separated list of exact origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=downtown_supermarket
DB_POOL_SIZE=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Set true when the API is behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false

# Payment provider (not configured yet, see docs/DEPLOYMENT.md)
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
